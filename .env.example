# ════════════════════════════════════════════════════════════
#  NEXUS AI — Environment Variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env file (it is in .gitignore).
# ════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────
# Environment: "development", "staging", or "production"
ENVIRONMENT=development
# Set to false in production
DEBUG=true
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────────────
# These are consumed both by the `db` service and the backend.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=nexus
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full async connection string (built from the parts above).
# When running the backend inside Docker, host is `db`.
# When running locally outside Docker, use `localhost`.
DATABASE_URL=postgresql+asyncpg://nexus:change_me_in_production@db:5432/nexus

# ─── LLM / Embeddings (added in Part 4+) ───────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ─── Web search for agents (added in Part 6) ───────────────
# Get from https://app.tavily.com  (free tier: 1000 searches/mo)
TAVILY_API_KEY=tvly-your-key-here

# ─── Text-to-speech (added in Part 7, optional) ────────────
# Get from https://elevenlabs.io  (free tier: 10k chars/mo)
# Leave blank to fall back to free gTTS.
ELEVENLABS_API_KEY=

# ─── Auth / Security (added in Part 3) ─────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_real_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Observability (added in Part 10, optional) ────────────
# Leave blank to disable.
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
