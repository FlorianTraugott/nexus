# Environment variables. Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file (it is in .gitignore).

# Application
# Environment: "development", "staging", "production", or "test"
ENVIRONMENT=development
# Defaults to false (production-safe). Local dev/Docker set it true for SQL echo
# and verbose errors.
DEBUG=true
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000
# Set true ONLY when a platform proxy (Railway) sits in front of the app, so the
# rate limiter reads the real client IP from X-Forwarded-For. Leave false locally.
TRUST_PROXY_HEADERS=false

# Database (PostgreSQL)
# These are consumed both by the `db` service and the backend.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=nexus
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional full connection string. Set this ONLY for managed Postgres
# (Railway/Render) — it OVERRIDES the POSTGRES_* parts above and is normalised to
# the asyncpg driver (postgres:// and ?sslmode=... are handled). Leave unset
# locally so the parts above drive it (host `db` in Docker, `localhost` outside).
# DATABASE_URL=
# Set true for managed Postgres (TLS required); false for local/Docker Postgres.
DB_SSL_REQUIRE=false

# LLM / Embeddings (added in Part 4+)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Web search for agents (added in Part 6)
# Get from https://app.tavily.com  (free tier: 1000 searches/mo)
TAVILY_API_KEY=tvly-your-key-here

# Text-to-speech (added in Part 7, optional)
# Get from https://elevenlabs.io  (free tier: 10k chars/mo)
# Leave blank to fall back to free gTTS.
ELEVENLABS_API_KEY=

# Auth / Security (added in Part 3)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_real_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo cost-exposure hardening (Part 12.5)
# Set false in the public demo so /auth/register returns 403. Default true.
REGISTRATION_ENABLED=true
# Per-user (JWT) limits on the OpenAI-spending endpoints. Buckets are per
# endpoint, so /query and /query/stream get separate 60/hour buckets; on the
# shared demo account these ceilings are GLOBAL across all visitors. Real spend
# backstop is the OpenAI project cap (dashboard), not these.
RATE_LIMIT_QUERY=60/hour
RATE_LIMIT_VISION=20/hour
RATE_LIMIT_RESEARCH=10/hour

# Observability (added in Part 10, optional)
# Leave blank to disable.
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
